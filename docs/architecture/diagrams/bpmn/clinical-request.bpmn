<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ClinicalRequest" targetNamespace="https://github.com/AlchemistBro/blood-supply-pet/bpmn">
  <bpmn:message id="Msg_Cancelled" name="Отмена заявки врачом" />
  <bpmn:collaboration id="Collaboration_Process_ClinicalRequest">
    <bpmn:participant id="Participant_Process_ClinicalRequest" name="Заявка врача: варианты → выбор → задание источнику → закрепление в АИСТ-М (ИНТ-05)" processRef="Process_ClinicalRequest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ClinicalRequest" name="Обработка заявки врача" isExecutable="false">
    <bpmn:documentation>ФП4: FR029–FR035, FR043, FR044, FR047, FR051, FR052; NFR009, NFR016, NFR017. Источники: docs/tasks/06-matching.md, docs/architecture/events.md, docs/architecture/security.md, ADR-0011, ADR-0024. Правила подбора демонстрационные (ADR-0010); клиническое решение принимает врач. Модель описательная (isExecutable=false).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_ClinicalRequest">
      <bpmn:lane id="L_doc" name="Врач-трансфузиолог">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_mat" name="matching">
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_def</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_def</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_loc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_def2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_def2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_tr" name="transfer">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_op" name="Оператор клиники-источника">
        <bpmn:flowNodeRef>CA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_inv" name="inventory → C01 АИСТ-М (ИНТ-05)">
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ntf" name="notification → C04 почта">
        <bpmn:flowNodeRef>N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_n</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Пациенту нужен компонент крови">
      <bpmn:outgoing>Flow_S_D1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="D1" name="Создать заявку: номер случая, вид, количество, срочность, AB0/Rh, фенотип, ограничения (FR029)">
      <bpmn:incoming>Flow_S_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D1_M1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="M1" name="Сохранить заявку: номер случая шифруется отдельно; ClinicalRequestCreated без номера; аудит">
      <bpmn:incoming>Flow_D1_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_M2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="M2" name="Шаг 1. Допустимость по правилам O15 и ограничениям O08 (FR030, FR047)">
      <bpmn:incoming>Flow_M1_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M2_M3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="M3" name="Шаг 2. Единицы, время получения, остаток источника; ранжирование с объяснением (FR031–FR034)">
      <bpmn:incoming>Flow_M2_M3</bpmn:incoming>
      <bpmn:outgoing>Flow_M3_G1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G1" name="Есть допустимый вариант?">
      <bpmn:incoming>Flow_M3_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_M4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_M_def</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_def" name="RequestDeficitRecorded(NO_ALLOWED_VARIANT); статус «дефицит»">
      <bpmn:incoming>Flow_G1_M_def</bpmn:incoming>
      <bpmn:outgoing>Flow_M_def_E_def</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_def" name="Дефицит заявки">
      <bpmn:incoming>Flow_M_def_E_def</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M4" name="VariantsOffered: варианты по рангу, stock_watermark">
      <bpmn:incoming>Flow_G1_M4</bpmn:incoming>
      <bpmn:outgoing>Flow_M4_Gm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gm">
      <bpmn:incoming>Flow_M4_Gm</bpmn:incoming>
      <bpmn:incoming>Flow_G4_Gm</bpmn:incoming>
      <bpmn:outgoing>Flow_Gm_D2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D2" name="Сравнить варианты с объяснением и выбрать (решение врача)">
      <bpmn:incoming>Flow_Gm_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D2_M5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="M5" name="DoctorChoiceRecorded: выбор с версиями входов; аудит">
      <bpmn:incoming>Flow_D2_M5</bpmn:incoming>
      <bpmn:outgoing>Flow_M5_G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Вариант местный?">
      <bpmn:incoming>Flow_M5_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_E_loc</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_M6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_loc" name="Местный вариант: закрепления в АС и письма нет">
      <bpmn:incoming>Flow_G2_E_loc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M6" name="Спецификация замены (ADR-0011); OpenObligation: choice_id, fallback_sources, срок по срочности">
      <bpmn:incoming>Flow_G2_M6</bpmn:incoming>
      <bpmn:outgoing>Flow_M6_T1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T1" name="Открыть O07 PENDING у источника, ObligationOpened">
      <bpmn:incoming>Flow_M6_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_P1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P1">
      <bpmn:incoming>Flow_T1_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_N1</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_CA</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="N1" name="Письмо оператору источника: ссылка, вид, объём, срочность (FR044)">
      <bpmn:incoming>Flow_P1_N1</bpmn:incoming>
      <bpmn:outgoing>Flow_N1_E_n</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_n" name="Сбой письма задание не отменяет">
      <bpmn:incoming>Flow_N1_E_n</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="CA" name="Подтверждение передачи (confirm-transfer.bpmn)" calledElement="Process_ConfirmTransfer">
      <bpmn:incoming>Flow_P1_CA</bpmn:incoming>
      <bpmn:outgoing>Flow_CA_G3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G3" name="Исход обязательства?">
      <bpmn:incoming>Flow_CA_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_M8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T2" name="AllocateUnitsToPatient → inventory.commands: ключ = O07 + версия (FR051)">
      <bpmn:incoming>Flow_G3_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_I1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="I1" name="inbox → aist_outbox_message одной TX; отправка в C01 с повтором тем же ключом (FR052, NFR017)">
      <bpmn:incoming>Flow_T2_I1</bpmn:incoming>
      <bpmn:outgoing>Flow_I1_I2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="I2" name="Квитанция C01: acknowledged_at, PatientAllocationAcknowledged">
      <bpmn:incoming>Flow_I1_I2</bpmn:incoming>
      <bpmn:outgoing>Flow_I2_M7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M7" name="Статус задания: «закрепление подтверждено АИСТ-М»">
      <bpmn:incoming>Flow_I2_M7</bpmn:incoming>
      <bpmn:outgoing>Flow_M7_E_ok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_ok" name="Задание исполняется: перевозка в саге подтверждения">
      <bpmn:incoming>Flow_M7_E_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M8" name="Подобрать следующий вариант по рангу или задание на остаток">
      <bpmn:incoming>Flow_G3_M8</bpmn:incoming>
      <bpmn:outgoing>Flow_M8_G4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="Вариант есть?">
      <bpmn:incoming>Flow_M8_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_M_def2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_Gm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_def2" name="RequestDeficitRecorded: SOURCE_REJECTED, NOT_CONFIRMED_IN_TIME или UNIT_WITHDRAWN">
      <bpmn:incoming>Flow_G4_M_def2</bpmn:incoming>
      <bpmn:outgoing>Flow_M_def2_E_def2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_def2" name="Дефицит заявки">
      <bpmn:incoming>Flow_M_def2_E_def2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ESP1" name="Отмена заявки врачом" triggeredByEvent="true">
      <bpmn:startEvent id="X1s" name="Врач отменил заявку: POST /requests/{id}/cancel">
        <bpmn:outgoing>Flow_X1s_X1t</bpmn:outgoing>
        <bpmn:messageEventDefinition id="X1s_ed" messageRef="Msg_Cancelled" />
      </bpmn:startEvent>
      <bpmn:task id="X1t" name="ClinicalRequestCancelled; CancelObligation(REQUEST_CANCELLED) по открытым O07; аудит">
        <bpmn:incoming>Flow_X1s_X1t</bpmn:incoming>
        <bpmn:outgoing>Flow_X1t_X1t2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="X1t2" name="transfer снимает закрепления; ReleasePatientAllocation в C01, если было закрепление">
        <bpmn:incoming>Flow_X1t_X1t2</bpmn:incoming>
        <bpmn:outgoing>Flow_X1t2_X1e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="X1e" name="Заявка отменена">
        <bpmn:incoming>Flow_X1t2_X1e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_X1s_X1t" sourceRef="X1s" targetRef="X1t" />
      <bpmn:sequenceFlow id="Flow_X1t_X1t2" sourceRef="X1t" targetRef="X1t2" />
      <bpmn:sequenceFlow id="Flow_X1t2_X1e" sourceRef="X1t2" targetRef="X1e" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_S_D1" sourceRef="S" targetRef="D1" />
    <bpmn:sequenceFlow id="Flow_D1_M1" sourceRef="D1" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_M1_M2" sourceRef="M1" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_M2_M3" sourceRef="M2" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_M3_G1" sourceRef="M3" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_M4" sourceRef="G1" targetRef="M4" name="да" />
    <bpmn:sequenceFlow id="Flow_G1_M_def" sourceRef="G1" targetRef="M_def" name="нет" />
    <bpmn:sequenceFlow id="Flow_M_def_E_def" sourceRef="M_def" targetRef="E_def" />
    <bpmn:sequenceFlow id="Flow_M4_Gm" sourceRef="M4" targetRef="Gm" />
    <bpmn:sequenceFlow id="Flow_Gm_D2" sourceRef="Gm" targetRef="D2" />
    <bpmn:sequenceFlow id="Flow_D2_M5" sourceRef="D2" targetRef="M5" />
    <bpmn:sequenceFlow id="Flow_M5_G2" sourceRef="M5" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_E_loc" sourceRef="G2" targetRef="E_loc" name="да" />
    <bpmn:sequenceFlow id="Flow_G2_M6" sourceRef="G2" targetRef="M6" name="нет" />
    <bpmn:sequenceFlow id="Flow_M6_T1" sourceRef="M6" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_P1" sourceRef="T1" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_P1_N1" sourceRef="P1" targetRef="N1" />
    <bpmn:sequenceFlow id="Flow_P1_CA" sourceRef="P1" targetRef="CA" />
    <bpmn:sequenceFlow id="Flow_N1_E_n" sourceRef="N1" targetRef="E_n" />
    <bpmn:sequenceFlow id="Flow_CA_G3" sourceRef="CA" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_T2" sourceRef="G3" targetRef="T2" name="Confirmed" />
    <bpmn:sequenceFlow id="Flow_G3_M8" sourceRef="G3" targetRef="M8" name="Rejected, Expired без запасного, Broken, недопоставка" />
    <bpmn:sequenceFlow id="Flow_T2_I1" sourceRef="T2" targetRef="I1" />
    <bpmn:sequenceFlow id="Flow_I1_I2" sourceRef="I1" targetRef="I2" />
    <bpmn:sequenceFlow id="Flow_I2_M7" sourceRef="I2" targetRef="M7" />
    <bpmn:sequenceFlow id="Flow_M7_E_ok" sourceRef="M7" targetRef="E_ok" />
    <bpmn:sequenceFlow id="Flow_M8_G4" sourceRef="M8" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_M_def2" sourceRef="G4" targetRef="M_def2" name="нет" />
    <bpmn:sequenceFlow id="Flow_G4_Gm" sourceRef="G4" targetRef="Gm" name="да: предложить врачу" />
    <bpmn:sequenceFlow id="Flow_M_def2_E_def2" sourceRef="M_def2" targetRef="E_def2" />
    <bpmn:textAnnotation id="A_k1">
      <bpmn:text>Номер случая (K1) хранится только в matching (pgcrypto) и показывается по отдельному запросу с записью READ_PATIENT_CASE в аудит (NFR016). ФИО и СНИЛС не вводятся.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_k1" sourceRef="D1" targetRef="A_k1" />
    <bpmn:textAnnotation id="A_rule">
      <bpmn:text>Ограничения заявки сильнее нехватки запаса: нет допустимого варианта — дефицит (FR030). Правила и нормативы демонстрационные (ADR-0010).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_rule" sourceRef="M2" targetRef="A_rule" />
    <bpmn:textAnnotation id="A_ext">
      <bpmn:text>Путь номера случая в ИНТ-05 задаёт ADR-0020 (запланирован, этап 6); в контрактах этапа 1 его нет (ADR-0027). Пока квитанции нет, O07 остаётся CONFIRMED (ADR-0003).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_ext" sourceRef="T2" targetRef="A_ext" />
    <bpmn:textAnnotation id="A_esc">
      <bpmn:text>Срок и эскалация к запасному источнику (fallback_sources) — внутри саги подтверждения.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_esc" sourceRef="CA" targetRef="A_esc" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ClinicalRequest">
    <bpmndi:BPMNPlane id="Plane_Process_ClinicalRequest" bpmnElement="Collaboration_Process_ClinicalRequest">
      <bpmndi:BPMNShape id="Participant_Process_ClinicalRequest_di" bpmnElement="Participant_Process_ClinicalRequest" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="3798" height="1470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_doc_di" bpmnElement="L_doc" isHorizontal="true">
        <dc:Bounds x="180" y="60" width="3768" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_mat_di" bpmnElement="L_mat" isHorizontal="true">
        <dc:Bounds x="180" y="300" width="3768" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_tr_di" bpmnElement="L_tr" isHorizontal="true">
        <dc:Bounds x="180" y="860" width="3768" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_op_di" bpmnElement="L_op" isHorizontal="true">
        <dc:Bounds x="180" y="1050" width="3768" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_inv_di" bpmnElement="L_inv" isHorizontal="true">
        <dc:Bounds x="180" y="1210" width="3768" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_ntf_di" bpmnElement="L_ntf" isHorizontal="true">
        <dc:Bounds x="180" y="1380" width="3768" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ESP1_di" bpmnElement="ESP1" isExpanded="true">
        <dc:Bounds x="522" y="700" width="1296" height="145" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="252" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="223" y="167" width="94" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D1_di" bpmnElement="D1">
        <dc:Bounds x="375" y="105" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M1_di" bpmnElement="M1">
        <dc:Bounds x="555" y="450" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M2_di" bpmnElement="M2">
        <dc:Bounds x="745" y="450" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M3_di" bpmnElement="M3">
        <dc:Bounds x="915" y="450" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="1145" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1123" y="433" width="94" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_def_di" bpmnElement="M_def">
        <dc:Bounds x="1285" y="580" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_def_di" bpmnElement="E_def">
        <dc:Bounds x="1476" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1450" y="642" width="88" height="14" />
