    <bpmn:sequenceFlow id="Flow_Gf_G_unk" sourceRef="Gf" targetRef="G_unk" name="нет" />
    <bpmn:sequenceFlow id="Flow_Gf_T_acc" sourceRef="Gf" targetRef="T_acc" name="есть: сверка вместо повтора" />
    <bpmn:sequenceFlow id="Flow_G_unk_T_failed" sourceRef="G_unk" targetRef="T_failed" name="да" />
    <bpmn:sequenceFlow id="Flow_T_failed_E_failed" sourceRef="T_failed" targetRef="E_failed" />
    <bpmn:sequenceFlow id="Flow_G_unk_K2" sourceRef="G_unk" targetRef="K2" name="нет" />
    <bpmn:sequenceFlow id="Flow_K2_G_res" sourceRef="K2" targetRef="G_res" />
    <bpmn:sequenceFlow id="Flow_G_res_T_acc" sourceRef="G_res" targetRef="T_acc" name="принят" />
    <bpmn:sequenceFlow id="Flow_G_res_T_ref" sourceRef="G_res" targetRef="T_ref" name="отказ" />
    <bpmn:sequenceFlow id="Flow_T_ref_E_ref" sourceRef="T_ref" targetRef="E_ref" />
