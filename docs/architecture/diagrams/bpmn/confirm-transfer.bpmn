    <bpmn:sequenceFlow id="Flow_T_acc_G_cf" sourceRef="T_acc" targetRef="G_cf" />
    <bpmn:sequenceFlow id="Flow_G_cf_T_TR" sourceRef="G_cf" targetRef="T_TR" name="да" />
    <bpmn:sequenceFlow id="Flow_G_cf_T_ign" sourceRef="G_cf" targetRef="T_ign" name="нет: BROKEN или CANCELLED" />
