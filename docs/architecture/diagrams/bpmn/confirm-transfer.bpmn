    <bpmn:sequenceFlow id="Flow_T3_G2" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_Gr" sourceRef="G2" targetRef="Gr" name="нет: InvalidRequest" />
    <bpmn:sequenceFlow id="Flow_G2_I1" sourceRef="G2" targetRef="I1" name="да" />
    <bpmn:sequenceFlow id="Flow_I1_G3a" sourceRef="I1" targetRef="G3a" />
    <bpmn:sequenceFlow id="Flow_G3a_G3b" sourceRef="G3a" targetRef="G3b" name="да" />
    <bpmn:sequenceFlow id="Flow_G3a_G_urg" sourceRef="G3a" targetRef="G_urg" name="нет ответа за 3 с или ответ из копии" />
    <bpmn:sequenceFlow id="Flow_G_urg_T_escSrc" sourceRef="G_urg" targetRef="T_escSrc" name="да" />
    <bpmn:sequenceFlow id="Flow_G_urg_Gr" sourceRef="G_urg" targetRef="Gr" name="нет" />
    <bpmn:sequenceFlow id="Flow_T_escSrc_Gr" sourceRef="T_escSrc" targetRef="Gr" />
    <bpmn:sequenceFlow id="Flow_G3b_Gr" sourceRef="G3b" targetRef="Gr" name="часть, без «частично»: UnitsUnavailable" />
    <bpmn:sequenceFlow id="Flow_G3b_T_rej" sourceRef="G3b" targetRef="T_rej" name="ни одной" />
    <bpmn:sequenceFlow id="Flow_T_rej_E_rej" sourceRef="T_rej" targetRef="E_rej" />
    <bpmn:sequenceFlow id="Flow_G3b_T_TX" sourceRef="G3b" targetRef="T_TX" name="все или часть с «частично»" />
    <bpmn:sequenceFlow id="Flow_T_TX_G4" sourceRef="T_TX" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_Gr" sourceRef="G4" targetRef="Gr" name="откат: UnitsUnavailable, ProtectedVolumeExceeded, UnitsTaken" />
    <bpmn:sequenceFlow id="Flow_G4_E_wd2" sourceRef="G4" targetRef="E_wd2" name="CAS не прошёл" />
    <bpmn:sequenceFlow id="Flow_G4_P1" sourceRef="G4" targetRef="P1" name="закреплено" />
