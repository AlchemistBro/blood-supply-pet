<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ConfirmTransfer" targetNamespace="https://github.com/AlchemistBro/blood-supply-pet/bpmn">
  <bpmn:message id="Msg_OpenObligation" name="OpenObligation" />
  <bpmn:message id="Msg_CancelObligation" name="CancelObligation" />
  <bpmn:message id="Msg_UnitWithdrawn" name="UnitWithdrawn / UnitUpdated(QUARANTINE)" />
  <bpmn:message id="Msg_TransportRejected" name="TransportRejected" />
  <bpmn:message id="Msg_CancelTransport" name="CancelTransport" />
  <bpmn:error id="Err_CarrierUnavailable" name="C03 недоступна или исход вызова неизвестен" errorCode="CARRIER_UNAVAILABLE" />
  <bpmn:escalation id="Esc_Duty" name="Эскалация дежурному смены" escalationCode="DUTY_OFFICER" />
  <bpmn:collaboration id="Collaboration_Process_ConfirmTransfer">
    <bpmn:participant id="Participant_Process_ConfirmTransfer" name="Подтверждение передачи: обязательство O07 от задания до доставки" processRef="Process_ConfirmTransfer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ConfirmTransfer" name="Подтверждение передачи (O07)" isExecutable="false">
    <bpmn:documentation>Сага подтверждения передачи. Источники: docs/domain/obligation-states.md, docs/architecture/saga-confirmation.md, ADR-0004, ADR-0011, ADR-0022, ADR-0027. Модель описательная (isExecutable=false): исполняет её код сервисов transfer и logistics-gateway.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_ConfirmTransfer">
      <bpmn:lane id="L_op" name="Оператор клиники-источника">
        <bpmn:flowNodeRef>Gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_tr" name="transfer — оркестратор саги">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_wd1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_idem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_idem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_escSrc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_wd2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_cf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_fb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_nofb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_nofb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_inv" name="inventory → C01 АИСТ-М">
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_gw" name="logistics-gateway (ACL к C03)">
        <bpmn:flowNodeRef>W1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_unk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_max</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_unk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_car" name="Перевозчик — служба перевозки (C03, ADR-0022)">
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="OpenObligation: выбор врача или предложение плана">
      <bpmn:outgoing>Flow_S1_T1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S1_ed" messageRef="Msg_OpenObligation" />
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Открыть O07 PENDING: срок по срочности, ObligationOpened, аудит">
      <bpmn:incoming>Flow_S1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_Gm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gm">
      <bpmn:incoming>Flow_T1_Gm</bpmn:incoming>
      <bpmn:incoming>Flow_U_retry_Gm</bpmn:incoming>
      <bpmn:outgoing>Flow_Gm_U1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U1" name="Проверить единицы и подтвердить: список, «частично», ключ идемпотентности">
      <bpmn:incoming>Flow_Gm_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B1" name="Срок подтверждения истёк (опрос 5 с)" attachedToRef="U1">
      <bpmn:outgoing>Flow_B1_T_exp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B1_ed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B2" name="CancelObligation" attachedToRef="U1">
      <bpmn:outgoing>Flow_B2_T_cancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B2_ed" messageRef="Msg_CancelObligation" />
    </bpmn:boundaryEvent>
    <bpmn:task id="T2" name="Найти O07, сверить статус и ключ">
      <bpmn:incoming>Flow_U1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Статус O07?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_E_wd1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T_idem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_wd1" name="Задание снято: TaskWithdrawn(status), «не отправляйте»">
      <bpmn:incoming>Flow_G1_E_wd1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_idem" name="Вернуть прежний результат Confirmed">
      <bpmn:incoming>Flow_G1_T_idem</bpmn:incoming>
      <bpmn:outgoing>Flow_T_idem_E_idem</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_idem" name="Повтор: Confirmed">
      <bpmn:incoming>Flow_T_idem_E_idem</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3" name="Проверить состав: разные единицы, не больше requested_qty, источник и вид">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Состав верен?">
      <bpmn:incoming>Flow_T3_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_Gr</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_I1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="I1" name="Точечный статус единиц: GET /internal/units/status, 3 с, предохранитель, вне блокировок">
      <bpmn:incoming>Flow_G2_I1</bpmn:incoming>
      <bpmn:outgoing>Flow_I1_G3a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3a" name="АИСТ-М ответила?">
      <bpmn:incoming>Flow_I1_G3a</bpmn:incoming>
      <bpmn:outgoing>Flow_G3a_G3b</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3a_G_urg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3b" name="Сколько единиц IN_STOCK?">
      <bpmn:incoming>Flow_G3a_G3b</bpmn:incoming>
      <bpmn:outgoing>Flow_G3b_Gr</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3b_T_rej</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3b_T_TX</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_urg" name="Срочность экстренная?">
      <bpmn:incoming>Flow_G3a_G_urg</bpmn:incoming>
      <bpmn:outgoing>Flow_G_urg_T_escSrc</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_urg_Gr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_escSrc" name="TX: EscalationRaised(SOURCE_SYSTEM_UNAVAILABLE), аудит">
      <bpmn:incoming>Flow_G_urg_T_escSrc</bpmn:incoming>
      <bpmn:outgoing>Flow_T_escSrc_Gr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_rej" name="TX: CAS PENDING→REJECTED, TransferRejected(UNITS_WITHDRAWN), аудит">
      <bpmn:incoming>Flow_G3b_T_rej</bpmn:incoming>
      <bpmn:outgoing>Flow_T_rej_E_rej</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_rej" name="Отклонено (Rejected)">
      <bpmn:incoming>Flow_T_rej_E_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_TX" name="Транзакция подтверждения">
      <bpmn:incoming>Flow_G3b_T_TX</bpmn:incoming>
      <bpmn:outgoing>Flow_T_TX_G4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="Итог транзакции?">
      <bpmn:incoming>Flow_T_TX_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_Gr</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_E_wd2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_P1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_wd2" name="Задание снято (TaskWithdrawn)">
      <bpmn:incoming>Flow_G4_E_wd2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gr">
      <bpmn:incoming>Flow_G2_Gr</bpmn:incoming>
      <bpmn:incoming>Flow_G_urg_Gr</bpmn:incoming>
      <bpmn:incoming>Flow_T_escSrc_Gr</bpmn:incoming>
      <bpmn:incoming>Flow_G3b_Gr</bpmn:incoming>
      <bpmn:incoming>Flow_G4_Gr</bpmn:incoming>
      <bpmn:outgoing>Flow_Gr_U_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_retry" name="Получить причину отказа; исправить выбор или повторить">
      <bpmn:incoming>Flow_Gr_U_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_U_retry_Gm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P1">
      <bpmn:incoming>Flow_G4_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_U2</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_T_out</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="U2" name="Получить «Закреплено, готовьте» в том же запросе; подготовить единицы">
      <bpmn:incoming>Flow_P1_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U2_E_prep</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_prep" name="Единицы готовы к передаче">
      <bpmn:incoming>Flow_U2_E_prep</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_out" name="Ретранслятор outbox: RequestTransport → logistics.commands (ключ = O07)">
      <bpmn:incoming>Flow_P1_T_out</bpmn:incoming>
      <bpmn:outgoing>Flow_T_out_W1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="W1" name="Принять команду: inbox и строка REQUESTING одной TX">
      <bpmn:incoming>Flow_T_out_W1</bpmn:incoming>
      <bpmn:outgoing>Flow_W1_Gx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gx">
      <bpmn:incoming>Flow_W1_Gx</bpmn:incoming>
      <bpmn:incoming>Flow_Gy_Gx</bpmn:incoming>
      <bpmn:outgoing>Flow_Gx_W2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="W2" name="Взять аренду строки: lease_owner, lease_until (30 с)">
      <bpmn:incoming>Flow_Gx_W2</bpmn:incoming>
      <bpmn:outgoing>Flow_W2_K1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="K1" name="Найти активный заказ по clientRef = o07-…">
      <bpmn:incoming>Flow_W2_K1</bpmn:incoming>
      <bpmn:outgoing>Flow_K1_Gf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="E1" name="Нет ответа" attachedToRef="K1">
      <bpmn:outgoing>Flow_E1_W_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="E1_ed" errorRef="Err_CarrierUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gf" name="Заказ у перевозчика есть?">
      <bpmn:incoming>Flow_K1_Gf</bpmn:incoming>
      <bpmn:outgoing>Flow_Gf_G_unk</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gf_T_acc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_unk" name="Строка уже UNKNOWN?">
      <bpmn:incoming>Flow_Gf_G_unk</bpmn:incoming>
      <bpmn:outgoing>Flow_G_unk_T_failed</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_unk_K2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_failed" name="FAILED: второй заказ вслепую не шлём">
      <bpmn:incoming>Flow_G_unk_T_failed</bpmn:incoming>
      <bpmn:outgoing>Flow_T_failed_E_failed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_failed" name="Заказа нет (FAILED)">
      <bpmn:incoming>Flow_T_failed_E_failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="K2" name="Создать заказ: POST /shipments, clientRef, режим">
      <bpmn:incoming>Flow_G_unk_K2</bpmn:incoming>
      <bpmn:outgoing>Flow_K2_G_res</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="E2" name="Нет ответа" attachedToRef="K2">
      <bpmn:outgoing>Flow_E2_W_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="E2_ed" errorRef="Err_CarrierUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="G_res" name="Ответ перевозчика?">
      <bpmn:incoming>Flow_K2_G_res</bpmn:incoming>
      <bpmn:outgoing>Flow_G_res_T_acc</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_res_T_ref</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_acc" name="ACCEPTED; outbox TransportAccepted, пока аренда наша">
      <bpmn:incoming>Flow_Gf_T_acc</bpmn:incoming>
      <bpmn:incoming>Flow_G_res_T_acc</bpmn:incoming>
      <bpmn:outgoing>Flow_T_acc_G_cf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_ref" name="REJECTED; outbox TransportRejected(REFUSED)">
      <bpmn:incoming>Flow_G_res_T_ref</bpmn:incoming>
      <bpmn:outgoing>Flow_T_ref_E_ref</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_ref" name="Отказ передан transfer">
      <bpmn:incoming>Flow_T_ref_E_ref</bpmn:incoming>
      <bpmn:messageEventDefinition id="E_ref_ed" messageRef="Msg_TransportRejected" />
    </bpmn:endEvent>
    <bpmn:task id="W_fail" name="Засчитать попытку: attempts + 1, пауза 1 с × 2^n">
      <bpmn:incoming>Flow_E1_W_fail</bpmn:incoming>
      <bpmn:incoming>Flow_E2_W_fail</bpmn:incoming>
      <bpmn:outgoing>Flow_W_fail_G_max</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_max" name="REQUESTING и попытки исчерпаны (5)?">
      <bpmn:incoming>Flow_W_fail_G_max</bpmn:incoming>
      <bpmn:outgoing>Flow_G_max_T_back</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_max_T_unk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="T_back" name="Ждать next_attempt_at: сверщик подберёт строку">
      <bpmn:incoming>Flow_G_max_T_back</bpmn:incoming>
      <bpmn:outgoing>Flow_T_back_Gy</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_back_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_unk" name="UNKNOWN; outbox TransportRejected(OUTCOME_UNKNOWN)">
      <bpmn:incoming>Flow_G_max_T_unk</bpmn:incoming>
      <bpmn:outgoing>Flow_T_unk_T_rech</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="T_rech" name="Перепроверка UNKNOWN (1 мин)">
      <bpmn:incoming>Flow_T_unk_T_rech</bpmn:incoming>
      <bpmn:outgoing>Flow_T_rech_Gy</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_rech_ed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gy">
      <bpmn:incoming>Flow_T_back_Gy</bpmn:incoming>
      <bpmn:incoming>Flow_T_rech_Gy</bpmn:incoming>
      <bpmn:outgoing>Flow_Gy_Gx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_cf" name="O07 ещё CONFIRMED?">
      <bpmn:incoming>Flow_T_acc_G_cf</bpmn:incoming>
      <bpmn:outgoing>Flow_G_cf_T_TR</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_cf_T_ign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_TR" name="inbox; CAS CONFIRMED→TRANSPORT_REQUESTED, transport_ref, TransportRequested">
      <bpmn:incoming>Flow_G_cf_T_TR</bpmn:incoming>
      <bpmn:outgoing>Flow_T_TR_U3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_ign" name="Не применять, запись в аудит: CancelTransport уже ушла">
      <bpmn:incoming>Flow_G_cf_T_ign</bpmn:incoming>
      <bpmn:outgoing>Flow_T_ign_E_ign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_ign" name="Поздний ответ не применён">
      <bpmn:incoming>Flow_T_ign_E_ign</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U3" name="Передать единицы работнику службы перевозки: проверка перед отправкой">
      <bpmn:incoming>Flow_T_TR_U3</bpmn:incoming>
      <bpmn:outgoing>Flow_U3_T_disp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="T_disp" name="TRANSPORT_REQUESTED→DISPATCHED, закрепления CONSUMED">
      <bpmn:incoming>Flow_U3_T_disp</bpmn:incoming>
      <bpmn:outgoing>Flow_T_disp_K3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="K3" name="Перевезти: режим, длительность, целостность контейнера, температура">
      <bpmn:incoming>Flow_T_disp_K3</bpmn:incoming>
      <bpmn:outgoing>Flow_K3_W_del</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="W_del" name="TransportDelivered: температура при отправке и прибытии → logistics.replies">
      <bpmn:incoming>Flow_K3_W_del</bpmn:incoming>
      <bpmn:outgoing>Flow_W_del_T_deliv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_deliv" name="Приёмка: условия и метаданные единиц; DISPATCHED→DELIVERED, при нарушениях запрет использования и эскалация">
      <bpmn:incoming>Flow_W_del_T_deliv</bpmn:incoming>
      <bpmn:outgoing>Flow_T_deliv_E_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_done" name="Доставлено (DELIVERED)">
      <bpmn:incoming>Flow_T_deliv_E_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_exp" name="ExpireOverdue, TX: CAS PENDING→EXPIRED, аудит">
      <bpmn:incoming>Flow_B1_T_exp</bpmn:incoming>
      <bpmn:outgoing>Flow_T_exp_G_fb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_fb" name="Есть запасной источник?">
      <bpmn:incoming>Flow_T_exp_G_fb</bpmn:incoming>
      <bpmn:outgoing>Flow_G_fb_T_next</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_fb_T_nofb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_next" name="Новое O07 PENDING у следующего источника (choice_id = uuid v5), TransferExpired(next_obligation_id)">
      <bpmn:incoming>Flow_G_fb_T_next</bpmn:incoming>
      <bpmn:outgoing>Flow_T_next_E_next</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_next" name="Эскалация к следующему источнику">
      <bpmn:incoming>Flow_T_next_E_next</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_nofb" name="TransferExpired, EscalationRaised(EXPIRED_NO_FALLBACK)">
      <bpmn:incoming>Flow_G_fb_T_nofb</bpmn:incoming>
      <bpmn:outgoing>Flow_T_nofb_E_nofb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_nofb" name="Эскалация дежурному">
      <bpmn:incoming>Flow_T_nofb_E_nofb</bpmn:incoming>
      <bpmn:escalationEventDefinition id="E_nofb_ed" escalationRef="Esc_Duty" />
    </bpmn:endEvent>
    <bpmn:task id="T_cancel" name="TX: CAS PENDING→CANCELLED, TransferCancelled, аудит">
      <bpmn:incoming>Flow_B2_T_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_T_cancel_E_canc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_canc" name="Отменено (CANCELLED)">
      <bpmn:incoming>Flow_T_cancel_E_canc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ESP1" name="Выбытие или карантин закреплённой единицы (компенсация)" triggeredByEvent="true">
      <bpmn:startEvent id="ESP1_s" name="UnitWithdrawn или UnitUpdated(QUARANTINE) по закреплённой единице" isInterrupting="false">
        <bpmn:outgoing>Flow_ESP1_s_ESP1_t1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ESP1_s_ed" messageRef="Msg_UnitWithdrawn" />
      </bpmn:startEvent>
      <bpmn:task id="ESP1_t1" name="TX: lock Остаток → CAS CONFIRMED | TRANSPORT_REQUESTED → BROKEN">
        <bpmn:incoming>Flow_ESP1_s_ESP1_t1</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP1_t1_ESP1_t2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ESP1_t2" name="Закрепления RELEASED, reserved − k; outbox TransferBroken(reason), CancelTransport; аудит">
        <bpmn:incoming>Flow_ESP1_t1_ESP1_t2</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP1_t2_ESP1_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP1_e" name="BROKEN; CancelTransport ушла шлюзу">
        <bpmn:incoming>Flow_ESP1_t2_ESP1_e</bpmn:incoming>
        <bpmn:messageEventDefinition id="ESP1_e_ed" messageRef="Msg_CancelTransport" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ESP1_s_ESP1_t1" sourceRef="ESP1_s" targetRef="ESP1_t1" />
      <bpmn:sequenceFlow id="Flow_ESP1_t1_ESP1_t2" sourceRef="ESP1_t1" targetRef="ESP1_t2" />
      <bpmn:sequenceFlow id="Flow_ESP1_t2_ESP1_e" sourceRef="ESP1_t2" targetRef="ESP1_e" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ESP2" name="Отмена после подтверждения" triggeredByEvent="true">
      <bpmn:startEvent id="ESP2_s" name="CancelObligation или отмена через API: O07 CONFIRMED или TRANSPORT_REQUESTED" isInterrupting="false">
        <bpmn:outgoing>Flow_ESP2_s_ESP2_t</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ESP2_s_ed" messageRef="Msg_CancelObligation" />
      </bpmn:startEvent>
      <bpmn:task id="ESP2_t" name="TX: CAS → CANCELLED, закрепления RELEASED, резерв снят, TransferCancelled, аудит">
        <bpmn:incoming>Flow_ESP2_s_ESP2_t</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP2_t_ESP2_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP2_e" name="CancelTransport(OBLIGATION_CANCELLED)">
        <bpmn:incoming>Flow_ESP2_t_ESP2_e</bpmn:incoming>
        <bpmn:messageEventDefinition id="ESP2_e_ed" messageRef="Msg_CancelTransport" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ESP2_s_ESP2_t" sourceRef="ESP2_s" targetRef="ESP2_t" />
      <bpmn:sequenceFlow id="Flow_ESP2_t_ESP2_e" sourceRef="ESP2_t" targetRef="ESP2_e" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ESP3" name="Перевозка не подтверждена" triggeredByEvent="true">
      <bpmn:startEvent id="ESP3_s" name="TransportRejected: REFUSED или OUTCOME_UNKNOWN" isInterrupting="false">
        <bpmn:outgoing>Flow_ESP3_s_ESP3_t</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ESP3_s_ed" messageRef="Msg_TransportRejected" />
      </bpmn:startEvent>
      <bpmn:task id="ESP3_t" name="O07 остаётся CONFIRMED: TransportRequestFailed, EscalationRaised(TRANSPORT_REFUSED | TRANSPORT_OUTCOME_UNKNOWN)">
        <bpmn:incoming>Flow_ESP3_s_ESP3_t</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP3_t_ESP3_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP3_e" name="Дежурный организует перевозку вручную">
        <bpmn:incoming>Flow_ESP3_t_ESP3_e</bpmn:incoming>
        <bpmn:escalationEventDefinition id="ESP3_e_ed" escalationRef="Esc_Duty" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ESP3_s_ESP3_t" sourceRef="ESP3_s" targetRef="ESP3_t" />
      <bpmn:sequenceFlow id="Flow_ESP3_t_ESP3_e" sourceRef="ESP3_t" targetRef="ESP3_e" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ESP4" name="Отмена перевозки (CancelTransport)" triggeredByEvent="true">
      <bpmn:startEvent id="ESP4_s" name="CancelTransport" isInterrupting="false">
        <bpmn:outgoing>Flow_ESP4_s_ESP4_g1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ESP4_s_ed" messageRef="Msg_CancelTransport" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ESP4_g1" name="Строка есть?">
        <bpmn:incoming>Flow_ESP4_s_ESP4_g1</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_g1_ESP4_g2</bpmn:outgoing>
        <bpmn:outgoing>Flow_ESP4_g1_ESP4_w4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="ESP4_g2" name="Заказ мог быть создан?">
        <bpmn:incoming>Flow_ESP4_g1_ESP4_g2</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_g2_ESP4_w1</bpmn:outgoing>
        <bpmn:outgoing>Flow_ESP4_g2_ESP4_m</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ESP4_w1" name="REQUESTING, UNKNOWN, ACCEPTED: флаг cancel_requested; drive под арендой: сверка, снять заказ у перевозчика">
        <bpmn:incoming>Flow_ESP4_g2_ESP4_w1</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_w1_ESP4_w2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ESP4_w2" name="CANCELLED; outbox TransportCancelled">
        <bpmn:incoming>Flow_ESP4_w1_ESP4_w2</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_w2_ESP4_e1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP4_e1" name="Заказ снят">
        <bpmn:incoming>Flow_ESP4_w2_ESP4_e1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="ESP4_m">
        <bpmn:incoming>Flow_ESP4_g2_ESP4_m</bpmn:incoming>
        <bpmn:incoming>Flow_ESP4_w4_ESP4_m</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_m_ESP4_w3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ESP4_w3" name="outbox TransportCancelled">
        <bpmn:incoming>Flow_ESP4_m_ESP4_w3</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_w3_ESP4_e2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP4_e2" name="Снимать нечего">
        <bpmn:incoming>Flow_ESP4_w3_ESP4_e2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="ESP4_w4" name="Отмена обогнала заказ. Надгробие: строка CANCELLED, поздний RequestTransport упрётся в первичный ключ">
        <bpmn:incoming>Flow_ESP4_g1_ESP4_w4</bpmn:incoming>
        <bpmn:outgoing>Flow_ESP4_w4_ESP4_m</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_ESP4_s_ESP4_g1" sourceRef="ESP4_s" targetRef="ESP4_g1" />
      <bpmn:sequenceFlow id="Flow_ESP4_g1_ESP4_g2" sourceRef="ESP4_g1" targetRef="ESP4_g2" name="да" />
      <bpmn:sequenceFlow id="Flow_ESP4_g1_ESP4_w4" sourceRef="ESP4_g1" targetRef="ESP4_w4" name="нет" />
      <bpmn:sequenceFlow id="Flow_ESP4_g2_ESP4_w1" sourceRef="ESP4_g2" targetRef="ESP4_w1" name="да" />
      <bpmn:sequenceFlow id="Flow_ESP4_g2_ESP4_m" sourceRef="ESP4_g2" targetRef="ESP4_m" name="нет: REJECTED или FAILED" />
      <bpmn:sequenceFlow id="Flow_ESP4_w1_ESP4_w2" sourceRef="ESP4_w1" targetRef="ESP4_w2" />
      <bpmn:sequenceFlow id="Flow_ESP4_w2_ESP4_e1" sourceRef="ESP4_w2" targetRef="ESP4_e1" />
      <bpmn:sequenceFlow id="Flow_ESP4_w4_ESP4_m" sourceRef="ESP4_w4" targetRef="ESP4_m" />
      <bpmn:sequenceFlow id="Flow_ESP4_m_ESP4_w3" sourceRef="ESP4_m" targetRef="ESP4_w3" />
      <bpmn:sequenceFlow id="Flow_ESP4_w3_ESP4_e2" sourceRef="ESP4_w3" targetRef="ESP4_e2" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_S1_T1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_Gm" sourceRef="T1" targetRef="Gm" />
