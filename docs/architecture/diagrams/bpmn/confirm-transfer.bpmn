    <bpmn:sequenceFlow id="Flow_T_exp_G_fb" sourceRef="T_exp" targetRef="G_fb" />
    <bpmn:sequenceFlow id="Flow_G_fb_T_next" sourceRef="G_fb" targetRef="T_next" name="да" />
