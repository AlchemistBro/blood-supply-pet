{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/logistics/TransportDelivered.v1.json",
  "title": "TransportDelivered",
  "description": "Ответ logistics.replies: перевозчик доставил груз. Температура при отправке и при приёме необязательна (ПП РФ № 641: регистрация температуры при перевозке).",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "delivered_at"],
  "properties": {
    "obligation_id": { "type": "string", "format": "uuid" },
    "delivered_at": { "type": "string", "format": "date-time" },
    "temperature_at_dispatch_c": { "type": "number", "minimum": -80, "maximum": 60 },
    "temperature_at_arrival_c": { "type": "number", "minimum": -80, "maximum": 60 }
  }
}
