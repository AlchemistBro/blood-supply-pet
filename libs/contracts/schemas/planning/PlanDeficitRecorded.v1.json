{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/planning/PlanDeficitRecorded.v1.json",
  "title": "PlanDeficitRecorded",
  "type": "object",
  "description": "Событие planning.events: непокрытая часть плана в реестре дефицита (O11, NFR014).",
  "additionalProperties": false,
  "required": [
    "deficit_record_id",
    "replenishment_plan_id",
    "clinic_id",
    "component_kind",
    "uncovered_volume_ml",
    "reason"
  ],
  "properties": {
    "deficit_record_id": {
      "type": "string",
      "format": "uuid"
    },
    "replenishment_plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "clinic_id": {
      "type": "integer",
      "minimum": 1
    },
    "component_kind": {
      "type": "string",
      "enum": [
        "RBC",
        "FFP",
        "PLT",
        "CRYO"
      ]
    },
    "blood_group": {
      "type": "string",
      "enum": [
        "O+",
        "O-",
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-"
      ]
    },
    "uncovered_volume_ml": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "enum": [
        "NO_SOURCE",
        "SOURCE_REJECTED",
        "NOT_CONFIRMED_IN_TIME",
        "UNIT_WITHDRAWN",
        "BELOW_UNIT_REMAINDER"
      ]
    }
  }
}
