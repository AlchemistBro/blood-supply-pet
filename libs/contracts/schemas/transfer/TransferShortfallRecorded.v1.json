{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/transfer/TransferShortfallRecorded.v1.json",
  "title": "TransferShortfallRecorded",
  "description": "Событие transfer.events: подтверждено меньше запрошенного; подбор или план ищет источник на остаток.",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "request_id", "component_kind", "shortfall"],
  "properties": {
    "obligation_id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "component_kind": { "type": "string", "enum": ["RBC", "FFP", "PLT", "CRYO"] },
    "shortfall": { "type": "integer", "minimum": 1 }
  }
}
