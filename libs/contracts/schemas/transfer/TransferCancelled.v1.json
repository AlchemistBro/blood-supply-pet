{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/transfer/TransferCancelled.v1.json",
  "title": "TransferCancelled",
  "description": "Событие transfer.events: обязательство отменено, закрепления сняты; после TRANSPORT_REQUESTED ушла CancelTransport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "request_id", "reason"],
  "properties": {
    "obligation_id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "reason": { "type": "string", "enum": ["REQUEST_CANCELLED", "PLAN_RECALCULATED", "DUTY_OFFICER_DECISION"] }
  }
}
