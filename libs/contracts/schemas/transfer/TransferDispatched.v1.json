{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/transfer/TransferDispatched.v1.json",
  "title": "TransferDispatched",
  "type": "object",
  "description": "Событие transfer.events: груз отправлен (TRANSPORT_REQUESTED → DISPATCHED).",
  "additionalProperties": false,
  "required": [
    "obligation_id",
    "request_id",
    "at"
  ],
  "properties": {
    "obligation_id": {
      "type": "string",
      "format": "uuid"
    },
    "obligation_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Версия O07 после перехода; проекции применяют событие, только если версия выше сохранённой"
    },
    "source_clinic_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Клиника-источник обязательства; для фильтра живых статусов без запроса к transfer"
    },
    "target_clinic_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Клиника-получатель обязательства; для фильтра живых статусов без запроса к transfer"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
