{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blood-supply.dev/schemas/transfer/CancelObligation.v1.json",
  "title": "CancelObligation",
  "description": "Команда transfer.commands: отменить обязательство (заявка отменена, план пересчитан, решение дежурного).",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "reason"],
