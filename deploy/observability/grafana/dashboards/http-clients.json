{
  "uid": "bs-http-clients",
  "title": "АС: исходящие HTTP-вызовы",
  "tags": [
    "blood-supply",
    "http",
    "clients"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Источник метрик",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "job",
        "label": "Сервис",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(httpx_client_calls_total, job)",
          "refId": "job"
        },
        "definition": "label_values(httpx_client_calls_total, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "blood-supply"
      ],
      "asDropdown": true,
      "title": "Дашборды АС"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Исходящие вызовы через `libs/httpx` (таймаут, повторы, предохранитель). Метрика `httpx.client.calls` с атрибутами `client` и `outcome` (ok, error, timeout, circuit_open) — итог вызова после повторов. Реализована в ветках этапа 1, в main появится со слиянием этапа 1."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Вызовы по исходу",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, client, outcome) (rate(httpx_client_calls_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} → {{client}}: {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Доля неуспешных вызовов",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, client) (rate(httpx_client_calls_total{job=~\"$job\",outcome!=\"ok\"}[$__rate_interval])) / sum by (job, client) (rate(httpx_client_calls_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} → {{client}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Предохранитель разомкнут",
      "description": "Вызовы, отклонённые разомкнутым предохранителем за 5 минут. Для transfer → inventory это «АИСТ-М недоступна»: runbook `docs/runbooks/aist-unavailable.md`.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, client) (increase(httpx_client_calls_total{job=~\"$job\",outcome=\"circuit_open\"}[5m]))",
          "legendFormat": "{{job}} → {{client}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Таймауты",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, client) (rate(httpx_client_calls_total{job=~\"$job\",outcome=\"timeout\"}[$__rate_interval]))",
          "legendFormat": "{{job}} → {{client}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
