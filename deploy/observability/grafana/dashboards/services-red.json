        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (job) (http_server_request_duration_seconds_count{job=~\"$job\"})",
          "legendFormat": "{{job}}",
          "datasource": {
