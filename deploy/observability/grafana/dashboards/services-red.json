          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Сервисы, приславшие метрики",
      "description": "Сервис пропал из списка — он не шлёт OTLP: упал или потерял связь с коллектором.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
