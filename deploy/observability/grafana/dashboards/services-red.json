        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$job\",http_response_status_code=~\"401|403\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{http_response_status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
