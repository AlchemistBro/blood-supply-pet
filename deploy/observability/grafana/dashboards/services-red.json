            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Отказы 401 и 403",
      "description": "Рост 403 у одного сервиса — повод открыть журнал аудита (ACCESS_DENIED, ADR-0025).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
