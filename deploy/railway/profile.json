{
  "description": "Перечень настроек для оператора, не импортируемый Railway template. Настройки deploy переносить в dashboard для image services.",
  "sharedVariables": [
    "PUBLIC_URL",
    "WEB_CLIENT_SECRET",
    "SERVICE_CLIENT_SECRET",
    "SESSION_KEY",
    "K1_KEY",
    "KEYCLOAK_ADMIN_PASSWORD",
    "POSTGRES_ADMIN_PASSWORD",
    "KAFKA_CLUSTER_ID",
    "DB_AUDIT_PASSWORD",
    "DB_INVENTORY_PASSWORD",
    "DB_DEMAND_PASSWORD",
    "DB_PLANNING_PASSWORD",
    "DB_MATCHING_PASSWORD",
    "DB_TRANSFER_PASSWORD",
    "DB_LOGISTICS_PASSWORD",
    "DB_NOTIFICATION_PASSWORD",
    "DB_KEYCLOAK_PASSWORD"
  ],
  "services": {
    "audit": {
      "image": "ghcr.io/alchemistbro/blood-supply-audit:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://audit:${{shared.DB_AUDIT_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/audit?sslmode=disable"
      },
      "deployConfig": "app.railway.json"
    },
    "inventory": {
      "image": "ghcr.io/alchemistbro/blood-supply-inventory:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://inventory:${{shared.DB_INVENTORY_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/inventory?sslmode=disable",
        "BS_AIST_URL": "http://${{sim-aist.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_K1_KEYS": "demo1:${{shared.K1_KEY}}"
      },
      "deployConfig": "app.railway.json"
    },
    "demand": {
      "image": "ghcr.io/alchemistbro/blood-supply-demand:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://demand:${{shared.DB_DEMAND_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/demand?sslmode=disable"
      },
      "deployConfig": "app.railway.json"
    },
    "planning": {
      "image": "ghcr.io/alchemistbro/blood-supply-planning:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://planning:${{shared.DB_PLANNING_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/planning?sslmode=disable"
      },
      "deployConfig": "app.railway.json"
    },
    "matching": {
      "image": "ghcr.io/alchemistbro/blood-supply-matching:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://matching:${{shared.DB_MATCHING_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/matching?sslmode=disable",
        "BS_K1_KEYS": "demo1:${{shared.K1_KEY}}"
      },
      "deployConfig": "app.railway.json"
    },
    "transfer": {
      "image": "ghcr.io/alchemistbro/blood-supply-transfer:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://transfer:${{shared.DB_TRANSFER_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/transfer?sslmode=disable",
        "BS_SERVICE_TOKEN_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/token",
        "BS_SERVICE_CLIENT_ID": "services",
        "BS_SERVICE_CLIENT_SECRET": "${{shared.SERVICE_CLIENT_SECRET}}",
        "BS_INVENTORY_URL": "http://${{inventory.RAILWAY_PRIVATE_DOMAIN}}:8080"
      },
      "deployConfig": "app.railway.json"
    },
    "logistics-gateway": {
      "image": "ghcr.io/alchemistbro/blood-supply-logistics-gateway:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://logistics:${{shared.DB_LOGISTICS_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/logistics?sslmode=disable",
        "BS_C03_URL": "http://${{sim-logistics.RAILWAY_PRIVATE_DOMAIN}}:8080"
      },
      "deployConfig": "app.railway.json"
    },
    "notification": {
      "image": "ghcr.io/alchemistbro/blood-supply-notification:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_DB_URL": "postgres://notification:${{shared.DB_NOTIFICATION_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/notification?sslmode=disable",
        "BS_SMTP_ADDR": "${{mailpit.RAILWAY_PRIVATE_DOMAIN}}:1025",
        "BS_WEB_BASE_URL": "${{shared.PUBLIC_URL}}"
      },
      "deployConfig": "app.railway.json"
    },
    "web": {
      "image": "ghcr.io/alchemistbro/blood-supply-web:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_OIDC_ISSUER": "${{shared.PUBLIC_URL}}/oidc/realms/blood-supply",
        "BS_OIDC_JWKS_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/certs",
        "BS_OIDC_AUDIENCE": "blood-supply-api",
        "BS_KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "BS_AUDIT_URL": "http://${{audit.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_INVENTORY_URL": "http://${{inventory.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_DEMAND_URL": "http://${{demand.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_PLANNING_URL": "http://${{planning.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_MATCHING_URL": "http://${{matching.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_TRANSFER_URL": "http://${{transfer.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_LOGISTICS_URL": "http://${{logistics-gateway.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_NOTIFICATION_URL": "http://${{notification.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_WEB_PUBLIC_URL": "${{shared.PUBLIC_URL}}",
        "BS_OIDC_DISCOVERY_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply",
        "BS_OIDC_CLIENT_SECRET": "${{shared.WEB_CLIENT_SECRET}}",
        "BS_SESSION_KEY": "${{shared.SESSION_KEY}}",
        "BS_COOKIE_SECURE": "true",
        "BS_HSTS_MAX_AGE": "31536000",
        "BS_SERVICE_CLIENT_SECRET": "${{shared.SERVICE_CLIENT_SECRET}}"
      },
      "deployConfig": "app.railway.json"
    },
    "sim-aist": {
      "image": "ghcr.io/alchemistbro/blood-supply-sim-aist:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_SIM_SEED_ON_START": "true",
        "BS_SIM_SEED_UNITS": "10000"
      },
      "deployConfig": "app.railway.json"
    },
    "sim-emergency": {
      "image": "ghcr.io/alchemistbro/blood-supply-sim-emergency:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false",
        "BS_SERVICE_TOKEN_URL": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc/realms/blood-supply/protocol/openid-connect/token",
        "BS_SERVICE_CLIENT_ID": "services",
        "BS_SERVICE_CLIENT_SECRET": "${{shared.SERVICE_CLIENT_SECRET}}",
        "BS_PLANNING_URL": "http://${{planning.RAILWAY_PRIVATE_DOMAIN}}:8080"
      },
      "deployConfig": "app.railway.json"
    },
    "sim-logistics": {
      "image": "ghcr.io/alchemistbro/blood-supply-sim-logistics:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "BS_HTTP_ADDR": "[::]:8080",
        "BS_ENV": "demo",
        "BS_LOG_LEVEL": "info",
        "BS_AUTH_DISABLED": "false"
      },
      "deployConfig": "app.railway.json"
    },
    "edge": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-edge:<ONE_SHA_TAG>",
      "public": true,
      "variables": {
        "PORT": "8080",
        "WEB_UPSTREAM": "${{web.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "KEYCLOAK_UPSTREAM": "${{keycloak.RAILWAY_PRIVATE_DOMAIN}}:8080"
      },
      "deployConfig": "edge.railway.json"
    },
    "keycloak": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-keycloak:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "PORT": "8080",
        "KC_DB_URL": "jdbc:postgresql://${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/keycloak",
        "KC_DB_USERNAME": "keycloak",
        "KC_DB_PASSWORD": "${{shared.DB_KEYCLOAK_PASSWORD}}",
        "KC_HOSTNAME": "${{shared.PUBLIC_URL}}/oidc",
        "KC_HOSTNAME_BACKCHANNEL_DYNAMIC": "true",
        "KC_HTTP_ENABLED": "true",
        "KC_HTTP_RELATIVE_PATH": "/oidc",
        "KC_PROXY_HEADERS": "xforwarded",
        "KC_BOOTSTRAP_ADMIN_USERNAME": "owner",
        "KC_BOOTSTRAP_ADMIN_PASSWORD": "${{shared.KEYCLOAK_ADMIN_PASSWORD}}",
        "BS_WEB_PUBLIC_URL": "${{shared.PUBLIC_URL}}",
        "BS_WEB_CLIENT_SECRET": "${{shared.WEB_CLIENT_SECRET}}",
        "BS_SERVICE_CLIENT_SECRET": "${{shared.SERVICE_CLIENT_SECRET}}"
      },
      "healthcheckPath": "/oidc/realms/blood-supply/.well-known/openid-configuration",
      "healthcheckTimeout": 300
    },
    "postgres": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-postgres:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "POSTGRES_PASSWORD": "${{shared.POSTGRES_ADMIN_PASSWORD}}",
        "PGDATA": "/var/lib/postgresql/data/pgdata"
      },
      "volume": "/var/lib/postgresql/data"
    },
    "kafka": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-kafka:<ONE_SHA_TAG>",
      "public": false,
      "volume": "/var/lib/kafka/data",
      "variables": {
        "CLUSTER_ID": "${{shared.KAFKA_CLUSTER_ID}}",
        "KAFKA_NODE_ID": "1",
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_LISTENERS": "INTERNAL://[::]:29092,CONTROLLER://[::]:9093",
        "KAFKA_ADVERTISED_LISTENERS": "INTERNAL://${{kafka.RAILWAY_PRIVATE_DOMAIN}}:29092",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "INTERNAL",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@${{kafka.RAILWAY_PRIVATE_DOMAIN}}:9093",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data"
      }
    },
    "mailpit": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-mailpit:<ONE_SHA_TAG>",
      "public": false,
      "variables": {
        "MP_SMTP_BIND_ADDR": "[::]:1025",
        "MP_UI_BIND_ADDR": "[::]:8025",
        "MP_MAX_MESSAGES": "500"
      }
    },
    "seed": {
      "image": "ghcr.io/alchemistbro/blood-supply-railway-seed:<ONE_SHA_TAG>",
      "public": false,
      "runOnce": true,
      "variables": {
        "BS_SEED_INVENTORY": "http://${{inventory.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_SEED_DEMAND": "http://${{demand.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_SEED_PLANNING": "http://${{planning.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_SEED_MATCHING": "http://${{matching.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_SEED_KEYCLOAK": "http://${{edge.RAILWAY_PRIVATE_DOMAIN}}:8080/oidc",
        "BS_SEED_AIST": "http://${{sim-aist.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "BS_SEED_SERVICE_SECRET": "${{shared.SERVICE_CLIENT_SECRET}}"
      },
      "restartPolicyType": "NEVER"
    }
  }
}
