# Лимиты общие для выделенного демо: заголовкам IP от посетителя не доверяем.
limit_req_zone $server_name zone=demo_pages:1m rate=100r/s;
limit_req_zone $server_name zone=demo_login:1m rate=10r/s;
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;
    resolver ${DNS_RESOLVER} valid=10s;
    client_max_body_size 6m;
    large_client_header_buffers 4 32k;
    limit_req_status 429;
    limit_req zone=demo_pages burst=100 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";

    location = /healthz {
        access_log off;
        return 200 "edge ready\n";
    }
    location = /readyz {
        set $web http://${WEB_UPSTREAM};
        proxy_pass $web;
    }
    location = /metrics { return 404; }
    location /dev/ { return 404; }
    location /api/ { return 404; }
    location /oidc/realms/blood-supply/ {
        limit_req zone=demo_login burst=30 nodelay;
        set $keycloak http://${KEYCLOAK_UPSTREAM};
        proxy_pass $keycloak;
    }
    location /oidc/resources/ {
        set $keycloak http://${KEYCLOAK_UPSTREAM};
        proxy_pass $keycloak;
    }
    location /oidc/ { return 404; }
    location /auth/ {
        limit_req zone=demo_login burst=30 nodelay;
        set $web http://${WEB_UPSTREAM};
        proxy_pass $web;
    }
    location / {
        set $web http://${WEB_UPSTREAM};
        proxy_pass $web;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
