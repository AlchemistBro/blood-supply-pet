# Скопируйте в .env (task env делает это сам). Значения демонстрационные, секретов здесь нет.
COMPOSE_PROJECT_NAME=blood-supply
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Публичный адрес Keycloak для браузера и значение iss в токенах
KEYCLOAK_PUBLIC_URL=http://localhost:8180
IMAGE_TAG=dev
# Секрет служебного клиента Keycloak (client credentials) — демо-значение из realm-blood-supply.json
SERVICES_CLIENT_SECRET=services-demo-secret
POSTGRES_HOST_PORT=5433
# web (ADR-0018): ключ шифрования cookie сессии, 32 байта в base64 (демо; сгенерировать свой:
# head -c 32 /dev/urandom | base64). Смена ключа без BS_SESSION_KEY_PREVIOUS разлогинивает всех.
BS_SESSION_KEY=/SOEjDxUt7nj0eKQL+i7zzr82TvK/a2fNw4TZh596RU=
# Адрес web, который видит браузер: https://localhost через nginx или http://localhost:8080 напрямую
WEB_PUBLIC_URL=https://localhost
# Ключи шифрования номера случая пациента (K1, ADR-0020): kid:base64(32 байта), первый — текущий.
# ДЕМО, НЕ ДЛЯ ЭКСПЛУАТАЦИИ: ключ публичный (base64 от "demo-k1-key-not-for-production!!").
# Передаётся только сервисам matching и inventory. Свой ключ: openssl rand -base64 32
BS_K1_KEYS=demo1:ZGVtby1rMS1rZXktbm90LWZvci1wcm9kdWN0aW9uISE= # gitleaks:allow (демо-ключ)
# Адрес inventory при запуске transfer локально вне compose.
BS_INVENTORY_URL=http://localhost:8101
