# Скопируйте в .env (task env делает это сам). Значения демонстрационные, секретов здесь нет.
COMPOSE_PROJECT_NAME=blood-supply
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Публичный адрес Keycloak для браузера и значение iss в токенах
KEYCLOAK_PUBLIC_URL=http://localhost:8180
IMAGE_TAG=dev
POSTGRES_HOST_PORT=5433
